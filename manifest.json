{
  "manifest_version": 3,
  "name": "LLM Universal Context Migrator",
  "version": "2.0",
  "description": "Migrates temporary chat context between Gemini and ChatGPT.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["scripts/content.js"]
    }
  ]
}